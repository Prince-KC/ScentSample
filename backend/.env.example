# ─── ScentSampleNepal Backend Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# Node environment
NODE_ENV=development

# Express server port
PORT=8000

# MongoDB connection string
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/scentSampleNepal
# Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scentSampleNepal?retryWrites=true&w=majority

# JWT secret key — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this
